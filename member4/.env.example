# ============================================================
# RELAY AI — MEMBER 4 ENVIRONMENT CONFIGURATION
# ============================================================

# ── DEMO SAFETY ──────────────────────────────────────────────
DEMO_MODE=true
DEMO_ALLOWLIST=+919999999999,+911234567890
MAX_DAILY_DEMO_CALLS=5
CALL_COOLDOWN_MINUTES=10
MAX_CALL_DURATION_SECONDS=300

# ── LOCAL LLM (Ollama) ──────────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── FALLBACK EXTERNAL LLM (only if local is insufficient) ──
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ── VOICE PIPELINE ──────────────────────────────────────────
STT_PROVIDER=whisper-local
TTS_PROVIDER=piper-local
# STT_PROVIDER=web-speech
# TTS_PROVIDER=web-speech

# ── TELEPHONY BRIDGE ────────────────────────────────────────
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── MEMBER 3 BACKEND ────────────────────────────────────────
MEMBER3_API_BASE_URL=http://localhost:5000/api

# ── SERVER ───────────────────────────────────────────────────
AI_SERVER_PORT=4000
AI_WS_PORT=4001

# ── LOGGING ──────────────────────────────────────────────────
LOG_LEVEL=info
